{{> head}}
<body>
{{> appShell}}
<section class="page-heading">
  <div><p class="eyebrow">SUPPLIER DIRECTORY</p><h1>{{title}}</h1><p>Supplier details are used when preparing purchase orders.</p></div>
  <a class="button button-secondary" href="/suppliers">← Back to suppliers</a>
</section>
<section class="panel form-panel">
  <form class="form-grid" method="POST" action="{{#if supplier.id}}/suppliers/{{supplier.id}}{{else}}/suppliers{{/if}}">
    <label class="span-2">Supplier name<input name="name" value="{{supplier.name}}" maxlength="160" required></label>
    <label>Contact person<input name="contactName" value="{{supplier.contactName}}" maxlength="120"></label>
    <label>Email address<input type="email" name="email" value="{{supplier.email}}" maxlength="190"></label>
    <label>Phone<input name="phone" value="{{supplier.phone}}" maxlength="40"></label>
    <label class="span-2">Address<input name="address" value="{{supplier.address}}" maxlength="255"></label>
    <div class="form-actions span-2"><a class="button button-secondary" href="/suppliers">Cancel</a><button class="button button-primary" type="submit">{{#if supplier.id}}Save changes{{else}}Add supplier{{/if}}</button></div>
  </form>
</section>
{{> appEnd}}
