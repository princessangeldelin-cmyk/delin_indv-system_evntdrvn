{{> head}}
<body>
{{> appShell}}
<section class="page-heading">
  <div><p class="eyebrow">PURCHASING</p><h1>Create purchase order</h1><p>Choose a supplier and add the products and quantities to order.</p></div>
  <a class="button button-secondary" href="/purchase-orders">← Back to orders</a>
</section>
<section class="panel form-panel">
  {{#unless suppliers.length}}<div class="notice notice-error">Add a supplier before creating a purchase order. <a href="/suppliers/new">Add supplier</a></div>{{/unless}}
  {{#unless products.length}}<div class="notice notice-error">Add a product before creating a purchase order. <a href="/products/new">Add product</a></div>{{/unless}}
  <form method="POST" action="/purchase-orders" id="order-form">
    <label class="form-label">Supplier<select id="supplier-select" name="supplierId" required><option value="">Select a supplier</option>{{#each suppliers}}<option value="{{id}}">{{name}}</option>{{/each}}</select></label>
    <div class="order-lines-heading"><div><h2>Order items</h2><p>Unit prices come from the product catalog.</p></div><button class="button button-secondary button-small" id="add-line" type="button">＋ Add item</button></div>
    <div class="order-lines" id="order-lines">
      <div class="order-line">
        <label>Product<select name="productIds" class="product-select" required><option value="">Select product</option>{{#each products}}<option value="{{id}}" data-price="{{unitPrice}}" data-supplier="{{supplierId}}">{{name}} {{#if sku}}({{sku}}){{/if}} · ${{unitPrice}}</option>{{/each}}</select></label>
        <label>Quantity<input name="quantities" type="number" min="1" step="1" value="" required></label>
        <div class="line-total"><span>Line total</span><strong>$0.00</strong></div>
        <button class="remove-line" type="button" aria-label="Remove item" title="Remove item">×</button>
      </div>
    </div>
    <template id="line-template"><div class="order-line">
      <label>Product<select name="productIds" class="product-select" required><option value="">Select product</option>{{#each products}}<option value="{{id}}" data-price="{{unitPrice}}" data-supplier="{{supplierId}}">{{name}} {{#if sku}}({{sku}}){{/if}} · ${{unitPrice}}</option>{{/each}}</select></label>
      <label>Quantity<input name="quantities" type="number" min="1" step="1" value="" required></label>
      <div class="line-total"><span>Line total</span><strong>$0.00</strong></div>
      <button class="remove-line" type="button" aria-label="Remove item" title="Remove item">×</button>
    </div></template>
    <div class="order-summary"><span>Order total</span><strong id="order-total">$0.00</strong></div>
    <p class="workflow-note">This order will be marked <strong>Pending approval</strong>. An administrator must approve it before delivery can be recorded.</p>
    <div class="form-actions"><a class="button button-secondary" href="/purchase-orders">Cancel</a><button class="button button-primary" type="submit" {{#unless suppliers.length}}disabled{{/unless}} {{#unless products.length}}disabled{{/unless}}>Create purchase order</button></div>
  </form>
</section>
<script>
  (() => {
    const lines = document.getElementById("order-lines");
    const template = document.getElementById("line-template");
    const supplier = document.getElementById("supplier-select");
    const total = document.getElementById("order-total");
    const money = value => "$" + value.toFixed(2);
    const update = () => {
      let sum = 0;
      lines.querySelectorAll(".order-line").forEach(line => {
        const select = line.querySelector(".product-select");
        const option = select.selectedOptions[0];
        const qty = Number(line.querySelector('[name="quantities"]').value || 0);
        const lineTotal = option && option.value ? Number(option.dataset.price) * qty : 0;
        line.querySelector(".line-total strong").textContent = money(lineTotal);
        sum += lineTotal;
      });
      total.textContent = money(sum);
    };
    const filterProducts = () => {
      lines.querySelectorAll(".product-select").forEach(select => {
        [...select.options].forEach(option => {
          if (!option.value || !supplier.value) return;
          option.disabled = option.dataset.supplier && option.dataset.supplier !== supplier.value;
        });
        if (select.selectedOptions[0]?.disabled) select.value = "";
      });
      update();
    };
    document.getElementById("add-line").addEventListener("click", () => {
      lines.appendChild(template.content.cloneNode(true));
      filterProducts();
    });
    lines.addEventListener("input", update);
    lines.addEventListener("change", update);
    lines.addEventListener("click", event => {
      if (!event.target.classList.contains("remove-line")) return;
      if (lines.querySelectorAll(".order-line").length > 1) event.target.closest(".order-line").remove();
      update();
    });
    supplier.addEventListener("change", filterProducts);
    filterProducts();
  })();
</script>
{{> appEnd}}
