{{> head}}
<body>
{{> appShell}}
<section class="page-heading">
  <div><p class="eyebrow">INVENTORY</p><h1>Products</h1><p>Monitor current stock and see which items need replenishing.</p></div>
  <a class="button button-primary" href="/products/new">＋ Add product</a>
</section>
<section class="panel" id="inventory">
  <div class="panel-heading"><div><h2>Product catalog</h2><p>{{products.length}} products · low stock is flagged automatically</p></div><input class="search-input" type="search" placeholder="Search products..." data-search="#product-table"></div>
  {{#if products.length}}
  <div class="table-wrap"><table id="product-table"><thead><tr><th>Product</th><th>Supplier</th><th>Unit price</th><th>Current stock</th><th>Minimum</th><th>Status</th><th>Actions</th></tr></thead><tbody>
    {{#each products}}<tr data-row><td><strong>{{name}}</strong><small class="table-sub">{{#if sku}}{{sku}}{{else}}No SKU{{/if}} · {{unit}}</small></td><td>{{#if Supplier}}{{Supplier.name}}{{else}}Any supplier{{/if}}</td><td>${{unitPrice}}</td><td>{{stockQuantity}}</td><td>{{minimumStock}}</td><td>{{#if (lt stockQuantity minimumStock)}}<span class="stock-low">Low stock</span>{{else}}<span class="stock-ok">In stock</span>{{/if}}</td><td><div class="table-actions"><a class="button button-small button-secondary" href="/products/{{id}}/edit">Edit</a><form method="POST" action="/products/{{id}}/delete" onsubmit="return confirm('Delete this product?')"><button class="button button-small button-danger" type="submit">Delete</button></form></div></td></tr>{{/each}}
  </tbody></table></div>
  {{else}}<div class="empty-state"><span>□</span><strong>No products yet</strong><p>Add products with current and minimum stock to begin monitoring inventory.</p><a class="button button-primary" href="/products/new">Add product</a></div>{{/if}}
</section>
{{> appEnd}}
