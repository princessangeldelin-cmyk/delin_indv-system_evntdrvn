{{> head}}
<body>
{{> appShell}}
<section class="page-heading">
  <div><p class="eyebrow">OVERVIEW</p><h1>Good to see you, {{currentUser.name}}</h1><p>Here is what is happening with your supply chain today.</p></div>
  <a class="button button-primary" href="/purchase-orders/new">＋ New purchase order</a>
</section>
<section class="stat-grid">
  <a class="stat-card" href="/suppliers"><span class="stat-icon icon-blue">♧</span><span class="stat-label">Total suppliers</span><strong>{{supplierCount}}</strong><small>Manage your supplier list</small></a>
  <a class="stat-card" href="/products"><span class="stat-icon icon-violet">□</span><span class="stat-label">Total products</span><strong>{{productCount}}</strong><small>Products in your catalog</small></a>
  <a class="stat-card" href="/purchase-orders"><span class="stat-icon icon-green">⇄</span><span class="stat-label">Purchase orders</span><strong>{{orderCount}}</strong><small>Orders created to date</small></a>
  <a class="stat-card" href="/products#inventory"><span class="stat-icon icon-orange">!</span><span class="stat-label">Low-stock products</span><strong>{{lowStockCount}}</strong><small>Below minimum stock</small></a>
  <a class="stat-card" href="/purchase-orders?status=Pending%20approval"><span class="stat-icon icon-orange">⌛</span><span class="stat-label">Awaiting approval</span><strong>{{pendingApprovalCount}}</strong><small>Purchase orders to review</small></a>
  <a class="stat-card" href="/purchase-orders"><span class="stat-icon icon-blue">↻</span><span class="stat-label">Awaiting delivery</span><strong>{{openDeliveryCount}}</strong><small>Approved or partly received</small></a>
  <a class="stat-card" href="/reports"><span class="stat-icon icon-green">$</span><span class="stat-label">Purchasing this month</span><strong>${{monthSpend}}</strong><small>Purchase order value</small></a>
</section>
<section class="dashboard-grid">
  <div class="panel">
    <div class="panel-heading"><div><h2>Stock to replenish</h2><p>Products below their minimum level</p></div><a class="text-link" href="/products">View inventory →</a></div>
    {{#if lowStockProducts.length}}
    <div class="table-wrap"><table><thead><tr><th>Product</th><th>Supplier</th><th>Current</th><th>Minimum</th><th>Recommendation</th></tr></thead><tbody>
      {{#each lowStockProducts}}
      <tr><td><strong>{{name}}</strong><small class="table-sub">{{sku}}</small></td><td>{{#if Supplier}}{{Supplier.name}}{{else}}—{{/if}}</td><td><span class="stock-low">{{stockQuantity}} {{unit}}</span></td><td>{{minimumStock}} {{unit}}</td><td><span class="recommendation">Restock {{recommendedQuantity}} {{unit}}</span></td></tr>
      {{/each}}
    </tbody></table></div>
    {{else}}<div class="empty-state"><span>✓</span><strong>Stock levels look good</strong><p>No products are currently below their minimum stock.</p></div>{{/if}}
  </div>
  <div class="panel">
    <div class="panel-heading"><div><h2>Recent purchase orders</h2><p>Latest activity across your suppliers</p></div><a class="text-link" href="/purchase-orders">View all →</a></div>
    {{#if recentOrders.length}}
    <div class="recent-list">{{#each recentOrders}}<a class="recent-order" href="/purchase-orders/{{id}}"><span class="recent-icon">⇄</span><span class="recent-copy"><strong>{{orderNumber}}</strong><small>{{Supplier.name}} · {{createdAt}}</small></span><span class="status status-{{statusClass status}}">{{status}}</span></a>{{/each}}</div>
    {{else}}<div class="empty-state"><span>⇄</span><strong>No purchase orders yet</strong><p>Create an order when products need replenishing.</p><a class="button button-secondary" href="/purchase-orders/new">Create first order</a></div>{{/if}}
  </div>
</section>
{{> appEnd}}